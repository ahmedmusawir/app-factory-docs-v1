+## 9. Performance Patterns
+
+### Image Optimization
+
+```typescript
+// next.config.ts
+
+import type { NextConfig } from 'next';
+
+const nextConfig: NextConfig = {
+  images: {
+    remotePatterns: [
+      {
+        protocol: 'https',
+        hostname: 'your-cdn.com',
+        pathname: '/**',
+      },
+      {
+        protocol: 'https',
+        hostname: 'your-wordpress.com',
+        pathname: '/wp-content/uploads/**',
+      },
+    ],
+  },
+};
+
+export default nextConfig;
